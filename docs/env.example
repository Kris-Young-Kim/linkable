# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=YOUR_SECRET_KEY

# Supabase
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Supabase JWT Secret (RLS 정책용)
# Supabase Dashboard > Settings > API > JWT Settings에서 확인
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET

# Google AI Studio (Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=YOUR_GENERATIVE_AI_API_KEY

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-EV15PW3ERH

# Meta Pixel (Facebook Pixel) - 구매 추적용
# Facebook Business Manager에서 Pixel ID를 발급받아 입력하세요
# https://business.facebook.com/events_manager2
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id_here



# Vercel Cron (선택사항)
CRON_SECRET=YOUR_CRON_SECRET

# Hyperbrowser (JavaScript 동적 로딩 페이지 크롤링용)
HYPERBROWSER_API_KEY=YOUR_HYPERBROWSER_API_KEY

# ============================================
# ISO 코드별 추천 상품 링크 (선택사항)
# ============================================
# 형식: ISO_[코드]_LINKS=링크1,링크2,링크3
# 공백은 언더스코어(_)로 변환됩니다.
# 예: "15 09" -> ISO_15_09_LINKS
# 
# 사용 방법:
# 1. ISO 코드의 공백을 언더스코어로 변환
# 2. ISO_ 접두사와 _LINKS 접미사 추가
# 3. 여러 링크는 쉼표로 구분
# ============================================

# 식사 및 음료섭취취 보조기기 (ISO 15 09)
# ISO_15_09_LINKS=https://naver.link/product1,https://11st.link/product1

# 수직 접근성 보조기기 (ISO 18 30)
# ISO_18_30_LINKS=https://naver.link/product2,https://gmarket.link/product2

# 의사소통 보조기기 (ISO 22 30)
# ISO_22_30_LINKS=https://careline.co.kr/product3